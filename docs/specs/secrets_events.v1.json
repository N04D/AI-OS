{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://specs/secrets_events.v1",
  "title": "AI-OS Secrets Events v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "action",
    "backend",
    "result"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "secrets_events.v1"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "user": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "set",
        "get",
        "delete",
        "list",
        "init",
        "rotate",
        "migrate",
        "backend_error"
      ]
    },
    "key": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "backend": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": ["ok", "missing", "partial", "denied", "error"]
    },
    "error_code": {
      "type": ["string", "null"]
    }
  }
}
