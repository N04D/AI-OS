FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN groupadd --system --gid 10001 aios \
    && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin aios

# FastAPI webhook runtime dependencies only.
RUN pip install --no-cache-dir fastapi uvicorn

COPY apps /app/apps
COPY kernel /app/kernel

USER 10001:10001

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "apps.telegram_webhook_app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--no-server-header"]
