#!/usr/bin/env python3
import json
import sys

line = sys.stdin.buffer.readline()
if not line:
    raise SystemExit(1)
req = json.loads(line.decode("utf-8"))
ok = req.get("method") == "on_event"
resp = {
    "type": "response",
    "id": req.get("id", ""),
    "ok": ok,
    "result": {"handled": ok},
    "error": None if ok else {"code": "METHOD_UNSUPPORTED"},
}
sys.stdout.write(json.dumps(resp) + "\n")
sys.stdout.flush()
