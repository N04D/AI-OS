#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ENV_FILE="${AIOS_ENV_FILE:-$REPO_ROOT/.env}"

PYTHON_BIN=""
if command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
else
  echo "ERROR: python3/python not found" >&2
  exit 22
fi

if [ -f "$ENV_FILE" ]; then
  while IFS= read -r raw_line || [ -n "$raw_line" ]; do
    line="${raw_line%$'\r'}"
    if [ -z "$line" ]; then
      continue
    fi
    if [[ "$line" =~ ^[[:space:]]*# ]]; then
      continue
    fi
    if [[ "$line" != *"="* ]]; then
      continue
    fi
    key="${line%%=*}"
    value="${line#*=}"
    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      continue
    fi
    if [ -z "${!key+x}" ]; then
      export "$key=$value"
    fi
  done <"$ENV_FILE"
fi

DEFAULT_HOST_STATE_DIR="${REPO_ROOT}/state"
HOST_STATE_DIR="${HOST_STATE_DIR:-$DEFAULT_HOST_STATE_DIR}"
if [ "$HOST_STATE_DIR" = "/home/infra/night/state" ] && [ "${ALLOW_LEGACY_INFRA_PATHS:-0}" != "1" ]; then
  echo "ERROR: legacy HOST_STATE_DIR /home/infra/night/state is forbidden; set ALLOW_LEGACY_INFRA_PATHS=1 to override intentionally." >&2
  exit 22
fi
LEDGER_DIR="${LEDGER_DIR:-$HOST_STATE_DIR/ledger}"
export HOST_STATE_DIR
export LEDGER_DIR

if [ "$#" -eq 0 ] && [ -t 0 ]; then
  exec "$PYTHON_BIN" -m supervisor.console
fi

exec "$PYTHON_BIN" -m supervisor.cli "$@"
